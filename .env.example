# 数据库（连接 127.0.0.1:3306，库 epro）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=epro
DB_USER=epro
DB_PASSWORD=your_password
DB_CHARSET=utf8mb4

# 麦蕊 API Token（逗号分隔，各 500 次/天）
MAIRUI_API_KEYS=your_token_1,your_token_2
MAIRUI_API_BASE=https://api.mairuiapi.com

# 测试阶段仅同步前 N 只股票（按 dm 排序），上限 100
SYNC_STOCK_LIMIT=100
